# ============================================
# BLOCKCHAIN PROJECT - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# LOCAL DEVELOPMENT & DEPLOYMENT (Used locally by Hardhat)
# ============================================
# Get this from MetaMask: Settings → Security & Privacy → Show Private Key
PRIVATE_KEY=your_metamask_private_key_here

# Sepolia RPC via drpc (Get API key at https://drpc.org/)
DRPC_API_KEY=your_drpc_api_key_here
SEPOLIA_RPC_URL=https://lb.drpc.live/sepolia/your_drpc_api_key_here

# Etherscan API Key (Get at https://etherscan.io/apis for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# FRONTEND CONFIGURATION (Used by React and Vercel)
# ============================================
REACT_APP_IPFS_GATEWAY=https://ipfs.io/ipfs/
REACT_APP_NETWORK_NAME=sepolia
REACT_APP_CHAIN_ID=11155111

# IPFS Provider configuration (pinata)
REACT_APP_IPFS_PROVIDER=pinata
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Contract Addresses (Automatically generated after deployment)
REACT_APP_ERC721_ADDRESS=your_deployed_erc721_address_here
REACT_APP_ERC1155_ADDRESS=your_deployed_erc1155_address_here
REACT_APP_MARKETPLACE_ADDRESS=your_deployed_marketplace_address_here
